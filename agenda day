/* AGENDAMENTOS DO PAINEL + CALENDÁRIO */
let calendarCursor = new Date(); calendarCursor = new Date(calendarCursor.getFullYear(),calendarCursor.getMonth(),1);
let selectedAppointmentDate = "";
const monthFormatter = new Intl.DateTimeFormat("pt-BR",{month:"long",year:"numeric"});
function localDateKey(year,month,day){return `${year}-${String(month+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`}
function renderAppointmentsCalendar(){
  const grid=$("appointmentsCalendar"); if(!grid)return;
  const y=calendarCursor.getFullYear(),m=calendarCursor.getMonth();
  $("calendarMonth").textContent=monthFormatter.format(calendarCursor);
  const names=["Dom","Seg","Ter","Qua","Qui","Sex","Sáb"];
  let html=names.map(n=>`<div class="calendar-weekday">${n}</div>`).join("");
  const offset=new Date(y,m,1).getDay(),days=new Date(y,m+1,0).getDate();
  for(let i=0;i<offset;i++)html+='<div></div>';
  const today=new Date(); const todayKey=localDateKey(today.getFullYear(),today.getMonth(),today.getDate());
  for(let day=1;day<=days;day++){
    const key=localDateKey(y,m,day);
    const count=state.appointments.filter(a=>a.appointment_date===key&&a.status!=="cancelado").length;
    const classes=["calendar-day",key===selectedAppointmentDate?"selected":"",key===todayKey?"today":""].filter(Boolean).join(" ");
    html+=`<button type="button" class="${classes}" data-calendar-date="${key}"><span>${day}</span>${count?`<span class="calendar-count">${count} horário${count===1?"":"s"}</span>`:""}</button>`;
  }
  grid.innerHTML=html;
  grid.querySelectorAll("[data-calendar-date]").forEach(btn=>btn.addEventListener("click",()=>{selectedAppointmentDate=btn.dataset.calendarDate;renderAppointmentsCalendar();renderAppointmentsList()}));
  const total=state.appointments.filter(a=>a.appointment_date===selectedAppointmentDate&&a.status!=="cancelado").length;
  $("calendarSummary").textContent=selectedAppointmentDate?`${selectedAppointmentDate.split("-").reverse().join("/")} · ${total} agendamento${total===1?"":"s"} (sem cancelados)`:"Selecione um dia para filtrar a lista. Os números verdes indicam horários agendados.";
}
function renderAppointmentsList(){
  const all=state.appointments||[];
  const data=selectedAppointmentDate?all.filter(a=>a.appointment_date===selectedAppointmentDate):all;
  if(!data.length){$("appointmentsList").innerHTML=`<div class="empty">${selectedAppointmentDate?"Nenhum agendamento nesta data.":"Nenhum agendamento encontrado."}</div>`;return}
  $("appointmentsList").innerHTML=`<div class="muted" style="margin:8px 0 12px">${selectedAppointmentDate?`Agendamentos de ${selectedAppointmentDate.split("-").reverse().join("/")}`:"Todos os agendamentos"}</div><div style="overflow:auto"><table style="width:100%;border-collapse:collapse;min-width:650px"><thead><tr>${["Cliente","Procedimento","Data e hora","Status"].map(x=>`<th style="text-align:left;padding:10px;border-bottom:1px solid var(--border)">${x}</th>`).join("")}</tr></thead><tbody>${data.map(a=>`
    <tr>
      <td style="padding:10px;border-bottom:1px solid var(--border)">${escapeHTML(a.client_name)}<br>${escapeHTML(a.client_phone)}</td>
      <td style="padding:10px;border-bottom:1px solid var(--border)">${escapeHTML(a.service_name||"")}<br>${money(a.price)}</td>
      <td style="padding:10px;border-bottom:1px solid var(--border)">${escapeHTML((a.appointment_date||"").split("-").reverse().join("/"))} · ${escapeHTML((a.appointment_time||"").slice(0,5))}</td>
      <td style="padding:10px;border-bottom:1px solid var(--border)"><select data-status-id="${escapeHTML(a.id)}"><option value="pendente" ${a.status==="pendente"?"selected":""}>Pendente</option><option value="confirmado" ${a.status==="confirmado"?"selected":""}>Confirmado</option><option value="concluido" ${a.status==="concluido"?"selected":""}>Concluído</option><option value="cancelado" ${a.status==="cancelado"?"selected":""}>Cancelado</option></select></td>
    </tr>`).join("")}</tbody></table></div>`;
  document.querySelectorAll("[data-status-id]").forEach(sel=>sel.addEventListener("change",async()=>{
    const {error}=await db.from("da_appointments").update({status:sel.value}).eq("id",sel.dataset.statusId);
    if(error)alert("Erro ao atualizar: "+error.message);else loadAppointments();
  }));
}
async function loadAppointments(){
  if(!db||!state.session)return;
  const {data,error}=await db.from("da_appointments").select("*").order("appointment_date").order("appointment_time");
  if(error){$("appointmentsList").innerHTML=`<div class="empty">Erro: ${escapeHTML(error.message)}</div>`;return}
  state.appointments=data||[];refreshTimeOptions();renderAppointmentsCalendar();renderAppointmentsList();
}
$("calendarPrev").addEventListener("click",()=>{calendarCursor=new Date(calendarCursor.getFullYear(),calendarCursor.getMonth()-1,1);renderAppointmentsCalendar()});
$("calendarNext").addEventListener("click",()=>{calendarCursor=new Date(calendarCursor.getFullYear(),calendarCursor.getMonth()+1,1);renderAppointmentsCalendar()});
