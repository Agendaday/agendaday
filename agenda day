$("anamnesisForm").addEventListener("submit",async e=>{
  e.preventDefault();
  if(!db)return setMessage("anamnesisMessage","Supabase não está configurado.",true);
  const authCheck=await ensureFreshAdminSession();
  if(!authCheck.ok)return setMessage("anamnesisMessage",authCheck.message,true);
  syncSheetsToFields();
  const row={};
  anamnesisFields.forEach(([key,id])=>{
    const el=$(id);
    if(id==='aHairHabit') row[key]=el.dataset.multipleValue||el.value||null;
    else row[key]=el.type==="checkbox"?el.checked:(el.value||null);
  });
  // Salva a assinatura no campo de texto já existente, sem exigir nova coluna no Supabase.
  // O texto original do termo e a data continuam preservados separadamente.
  row.responsibility_notes=JSON.stringify({
    version:1,
    text:$('aResponsibility').value||'',
    professional_signature:$('aProfessionalSignature').value||'',
    client_name:$('aResponsibilityName').value||'',
    client_rg:$('aResponsibilityRG').value||'',
    client_cpf:$('aResponsibilityCPF').value||'',
    city:$('aResponsibilityCity').value||'Porto Velho - RO',
    responsibility_date:$('aResponsibilityDate').value||''
  });
  // Guarda tratamento e seleções do cronograma na coluna já existente cycle_treatments.
  row.cycle_treatments=JSON.stringify({
    version:2,
    cycles:[1,2,3,4,5].map(n=>[1,2,3,4].map(j=>$("aCycleTreatment"+n+"_"+j)).filter(el=>el&&el.checked).map(el=>el.value))
  });
  row.birth_date=row.birth_date||null;
  const id=$("anamnesisId").value;
  const result=await saveAnamnesisWithRetry(row,id);
  if(result.error){
    const expired=/jwt expired|invalid jwt|token.*expired/i.test(result.error.message||"");
    return setMessage("anamnesisMessage",expired?"Sua sessão expirou. Entre novamente como administrador e tente salvar.":"Erro ao salvar: "+result.error.message,true);
  }
  $("anamnesisForm").reset(); const habit=$('aHairHabit'); if(habit)habit.dataset.multipleValue=''; syncAnamnesisChoices();setSheetRows('procedureSheet','[]','procedure');setSheetRows('budgetSheet','[]','budget');$("anamnesisId").value="";
  await loadAnamneses();setMessage("anamnesisMessage","Ficha salva com sucesso.");
});
$("clearAnamnesis").addEventListener("click",()=>{$("anamnesisForm").reset(); const habit=$('aHairHabit'); if(habit)habit.dataset.multipleValue=''; syncAnamnesisChoices();setSheetRows('procedureSheet','[]','procedure');setSheetRows('budgetSheet','[]','budget');$("anamnesisId").value=""});
async function loadAnamneses(){
  if(!db||!state.session)return;
  const {data,error}=await db.from("da_anamneses").select("id,name,contact,birth_date,created_at").order("created_at",{ascending:false});
  const host=$("anamnesisList");
  if(error){host.innerHTML=`<div class="empty">Erro ao carregar fichas: ${escapeHTML(error.message)}. Confira a tabela da anamnese.</div>`;return}
  state.anamneses=data||[];
  renderAnamnesisLists();
}
function renderAnamnesisLists(){
  const data=state.anamneses||[];
  const host=$("anamnesisList");
  if(host){
    if(!data.length)host.innerHTML='<div class="empty">Nenhuma ficha salva ainda.</div>';
    else host.innerHTML=`<div class="cards">${data.map(a=>`<article class="item-card"><h4>${escapeHTML(a.name)}</h4><p>${escapeHTML(a.contact||"Sem contato")} · ${escapeHTML(a.birth_date||"Nascimento não informado")}</p><div class="item-actions"><button class="btn btn-small" data-open-anamnesis="${a.id}">Carregar ficha</button><button class="btn btn-danger btn-small" data-remove-anamnesis="${a.id}">Excluir</button></div></article>`).join("")}</div>`;
    host.querySelectorAll("[data-open-anamnesis]").forEach(b=>b.addEventListener("click",()=>openAnamnesis(b.dataset.openAnamnesis)));
    host.querySelectorAll("[data-remove-anamnesis]").forEach(b=>b.addEventListener("click",()=>removeAnamnesis(b.dataset.removeAnamnesis)));
  }
  renderSavedAnamnesisList();
}
function renderSavedAnamnesisList(){
  const host=$("savedAnamnesisList");
  if(!host)return;
  const term=($("savedAnamnesisSearch")?.value||"").trim().toLowerCase();
  const filtered=(state.anamneses||[]).filter(a=>(a.name||"").toLowerCase().includes(term)||(a.contact||"").toLowerCase().includes(term));
  if(!filtered.length){host.innerHTML='<div class="empty">Nenhuma ficha encontrada.</div>';return;}
  host.innerHTML=`<div class="cards">${filtered.map(a=>`<article class="item-card"><h4>${escapeHTML(a.name||"Sem nome")}</h4><p>${escapeHTML(a.contact||"Sem contato")}<br>Data de nascimento: ${escapeHTML(a.birth_date||"Não informada")}</p><div class="item-actions"><button class="btn btn-primary btn-small" data-open-saved="${a.id}" type="button">Abrir ficha</button></div></article>`).join("")}</div>`;
  host.querySelectorAll("[data-open-saved]").forEach(b=>b.addEventListener("click",()=>{showAdminTab("anamnesis");openAnamnesis(b.dataset.openSaved)}));
}
$("savedAnamnesisSearch").addEventListener("input",renderSavedAnamnesisList);
$("refreshSavedAnamneses").addEventListener("click",loadAnamneses);
async function openAnamnesis(id){
  const {data,error}=await db.from("da_anamneses").select("*").eq("id",id).single();
  if(error)return alert("Não foi possível abrir a ficha: "+error.message);
  anamnesisFields.forEach(([key,field])=>{
    const el=$(field);
    if(field==='aHairHabit') { el.dataset.multipleValue=data[key]??''; el.value=(data[key]||'').split(' | ')[0]||''; }
    else if(el.type==="checkbox")el.checked=(data[key]===true||data[key]==="Sim"||data[key]==="true");
    else el.value=data[key]??"";
  });
  // Compatibilidade com registros antigos que guardavam o termo como texto puro.
  if(data.responsibility_notes){
    try{
      const savedTerm=JSON.parse(data.responsibility_notes);
      if(savedTerm && savedTerm.version===1){
        $('aResponsibility').value=savedTerm.text||'';
        $('aProfessionalSignature').value=savedTerm.professional_signature||'';
        $('aResponsibilityName').value=savedTerm.client_name||'';
        $('aResponsibilityRG').value=savedTerm.client_rg||'';
        $('aResponsibilityCPF').value=savedTerm.client_cpf||'';
        $('aResponsibilityCity').value=savedTerm.city||'Porto Velho - RO';
        $('aResponsibilityDate').value=savedTerm.responsibility_date||'';
      }
    }catch(e){ $('aResponsibility').value=data.responsibility_notes; }
  }
  syncAnamnesisChoices();
  setSheetRows('procedureSheet',data.prescription||'','procedure');
  setSheetRows('budgetSheet',data.budget_details||'','budget');
  // Compatibilidade com fichas antigas: se cycle_treatments era texto livre, não quebra a abertura.
  const savedCycles=data.cycle_treatments;
  if(savedCycles){
    try{
      const parsed=JSON.parse(savedCycles);
      if(parsed&&(parsed.version===1||parsed.version===2)){
        (parsed.cycles||[]).forEach((values,index)=>{
          const selected=Array.isArray(values)?values:(values?[values]:[]);
          [1,2,3,4].forEach(j=>{const el=$("aCycleTreatment"+(index+1)+"_"+j);if(el)el.checked=selected.includes(el.value);});
        });
      }
    }catch(e){ /* Ficha antiga com texto livre: mantém os outros campos normalmente. */ }
  }
  $("anamnesisId").value=data.id;$("anamnesisForm").scrollIntoView({behavior:"smooth"});
}
async function removeAnamnesis(id){
  if(!confirm("Excluir permanentemente esta ficha?"))return;
  const {error}=await db.from("da_anamneses").delete().eq("id",id);
  if(error)return alert("Erro ao excluir: "+error.message);
  await loadAnamneses();
}

/* INICIALIZAÇÃO E RECUPERAÇÃO DA SESSÃO */
async function init(){
  routeFromHash();
  if(!db){
    $("bookingNotice").textContent="O visual está pronto, mas ainda falta configurar a URL e a chave pública do Supabase.";
    renderPublicServices();return;
  }
  const {data:{session},error}=await db.auth.getSession();
  if(error)console.error(error);
  state.session=session;updateAdminVisibility();
  await loadServices();
  if(session&&location.hash==="#admin")showTab("admin");
  db.auth.onAuthStateChange((_event,session)=>{
    state.session=session;updateAdminVisibility();
    if(session)loadServices();
  });
  // Reativa a renovação quando a aba volta ao primeiro plano, comum em uso diário.
  document.addEventListener("visibilitychange",()=>{
    if(document.visibilityState==="visible") db.auth.startAutoRefresh();
    else db.auth.stopAutoRefresh();
  });
}
