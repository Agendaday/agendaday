// Opções clicáveis no estilo da ficha antiga: os selects continuam sendo usados internamente para salvar no Supabase.
function enhanceAnamnesisSelects(){
  document.querySelectorAll('#anamnesisForm select').forEach((select,index)=>{
    if(select.dataset.pillsReady) return;
    select.dataset.pillsReady='1';
    const wrap=document.createElement('div'); wrap.className='choice-pills'; wrap.dataset.forSelect=select.id;
    [...select.options].forEach((option,i)=>{
      if(i===0 && !option.value) return;
      const label=document.createElement('label'); label.className='choice-pill';
      const control=document.createElement('input');
      // Hábito com o cabelo permite marcar várias opções, como na ficha antiga.
      control.type=select.id==='aHairHabit'?'checkbox':'radio';
      control.name=control.type==='radio'?'choice_'+(select.id||index):'choice_'+select.id+'_'+i;
      control.value=option.value || option.textContent;
      control.addEventListener('change',()=>{
        if(select.id==='aHairHabit'){
          const chosen=[...wrap.querySelectorAll('input[type=checkbox]:checked')].map(el=>el.value);
          select.dataset.multipleValue=chosen.join(' | ');
          select.value=chosen[0]||'';
        } else select.value=option.value;
        select.dispatchEvent(new Event('change',{bubbles:true}));
      });
      label.append(control,document.createTextNode(' '+option.textContent)); wrap.append(label);
    });
    select.classList.add('anamnesis-select-native'); select.insertAdjacentElement('afterend',wrap);
  });
  syncAnamnesisChoices();
}
function syncAnamnesisChoices(){
  document.querySelectorAll('#anamnesisForm select').forEach(select=>{
    const wrap=document.querySelector('.choice-pills[data-for-select="'+select.id+'"]'); if(!wrap)return;
    if(select.id==='aHairHabit'){
      const chosen=(select.dataset.multipleValue||select.value||'').split(' | ').filter(Boolean);
      wrap.querySelectorAll('input[type=checkbox]').forEach(c=>c.checked=chosen.includes(c.value));
    } else wrap.querySelectorAll('input[type=radio]').forEach(r=>r.checked=(r.value===select.value && !!select.value));
  });
}
// Tabelas editáveis no estilo Excel. Os dados são guardados nas colunas existentes do Supabase.
function sheetAddRow(tableId, values={}, kind){
  const tbody=$(tableId).querySelector('tbody'); const tr=document.createElement('tr');
  const cols=kind==='procedure'?[['procedure','text','Nome do procedimento'],['date','date',''],['value','text','0,00']]:[['description','text','Serviço ou produto'],['value','text','0,00']];
  cols.forEach(([key,type,placeholder])=>{const td=document.createElement('td');const input=document.createElement('input');input.type=type;input.dataset.col=key;input.placeholder=placeholder;input.value=values[key]||'';if(key==='value'){input.inputMode='decimal';input.addEventListener('input',updateBudgetTotal)}td.appendChild(input);tr.appendChild(td)});
  const td=document.createElement('td');const del=document.createElement('button');del.type='button';del.className='sheet-remove';del.textContent='×';del.title='Remover linha';del.addEventListener('click',()=>{tr.remove();if(tableId==='budgetSheet')updateBudgetTotal()});td.appendChild(del);tr.appendChild(td);tbody.appendChild(tr);
}
function sheetRows(tableId){return [...$(tableId).querySelectorAll('tbody tr')].map(tr=>Object.fromEntries([...tr.querySelectorAll('input[data-col]')].map(i=>[i.dataset.col,i.value.trim()]))).filter(row=>Object.values(row).some(Boolean))}
function setSheetRows(tableId, raw, kind){
  const tbody=$(tableId).querySelector('tbody');tbody.innerHTML='';let rows=[];
  if(raw){try{const parsed=JSON.parse(raw);if(Array.isArray(parsed))rows=parsed;else if(typeof parsed==='string')rows=[];}catch(e){/* conteúdo antigo de texto livre */}}
  if(rows.length)rows.forEach(r=>sheetAddRow(tableId,r,kind));else sheetAddRow(tableId,{},kind);
  if(tableId==='budgetSheet')updateBudgetTotal();
}
async function ensureFreshAdminSession(forceRefresh=false){
  if(!db) return {ok:false,message:"Supabase não está configurado."};
  // Primeiro deixa o cliente recuperar a sessão persistida e o refresh token.
  const current=await db.auth.getSession();
  let session=current.data?.session||null;
  if(session && (forceRefresh || !session.expires_at || session.expires_at*1000<Date.now()+90_000)){
    const refreshed=await db.auth.refreshSession();
    if(!refreshed.error && refreshed.data?.session) session=refreshed.data.session;
    else if(!session || /refresh token.*(not found|invalid|already used)|token is expired/i.test(refreshed.error?.message||'')) session=null;
  }
  if(!session){
    state.session=null;updateAdminVisibility();
    return {ok:false,message:"A sessão não pôde ser renovada. Entre novamente como administrador; suas fichas salvas continuam no banco."};
  }
  state.session=session;
  return {ok:true,session};
}
async function saveAnamnesisWithRetry(row,id){
  let result=id?await db.from("da_anamneses").update(row).eq("id",id):await db.from("da_anamneses").insert(row);
  if(result.error && /jwt expired|invalid jwt|token.*expired/i.test(result.error.message||'')){
    const auth=await ensureFreshAdminSession(true);
    if(!auth.ok) return {error:{message:auth.message}};
    // Reexecuta a operação uma única vez com o access token renovado.
    result=id?await db.from("da_anamneses").update(row).eq("id",id):await db.from("da_anamneses").insert(row);
  }
  return result;
}
function syncSheetsToFields(){ $('aPrescription').value=JSON.stringify(sheetRows('procedureSheet'));$('aBudget').value=JSON.stringify(sheetRows('budgetSheet')); }
function updateBudgetTotal(){
  const total=sheetRows('budgetSheet').reduce((sum,row)=>{let v=(row.value||'').replace(/R\$\s?/gi,'').replace(/\./g,'').replace(',','.').replace(/[^0-9.-]/g,'');const n=Number(v);return sum+(Number.isFinite(n)?n:0)},0);
  $('budgetTotal').textContent=total.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
}
