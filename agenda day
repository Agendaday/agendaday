    client_name:$("clientName").value.trim(),
    client_phone:$("clientPhone").value.trim(),
    client_email:$("bookingEmail").value.trim()||null,
    service_id:service.id,service_name:service.name,price:service.price,
    appointment_date:$("bookingDate").value,appointment_time:$("bookingTime").value,
    notes:$("bookingNotes").value.trim()||null,status:"pendente"
