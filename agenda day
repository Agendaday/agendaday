<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DayAgenda — Salão de beleza</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  color-scheme: light;
  --bg:#fff;--surface:#fff;--surface2:#f2f2f2;--text:#111;
  --muted:#555;--border:#d4d4d4;--accent:#111;--accent-soft:#ededed;
  --danger:#8a1c1c;--success:#245c3a;
}
[data-theme="dark"] {
  color-scheme: dark;
  --bg:#000;--surface:#101010;--surface2:#1b1b1b;--text:#fff;
  --muted:#c2c2c2;--border:#383838;--accent:#fff;--accent-soft:#292929;
  --danger:#ff8a8a;--success:#8be0a8;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
header{position:sticky;top:0;background:var(--surface);border-bottom:1px solid var(--border);z-index:5}
.topbar{max-width:1100px;margin:auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:12px}
.brand-mark{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--accent-soft);font-size:22px;font-weight:bold}
.brand h1{font-size:20px;margin:0}
.brand p{font-size:12px;color:var(--muted);margin:4px 0 0}
.container{max-width:1100px;margin:auto;padding:25px 18px 50px}
.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;margin-bottom:22px}
.panel,.hero-copy,.hero-side{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:24px}
.hero-copy h2{font-size:clamp(30px,4vw,46px);margin:18px 0 12px}
.hero-copy p,.hero-side p{color:var(--muted);line-height:1.6}
.hero-side{display:flex;flex-direction:column;justify-content:center;background:var(--surface2)}
.hero-icon{font-size:40px}
.btn{padding:11px 15px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);font-weight:bold}
.btn-primary{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.btn-danger{color:var(--danger)}
.btn-small{padding:7px 10px;font-size:12px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.tab{background:var(--surface);border:1px solid var(--border);color:var(--muted);padding:10px 14px;border-radius:10px;font-weight:bold}
.tab.active{background:var(--accent-soft);color:var(--text);border-color:var(--accent)}
.panel{margin-bottom:18px}
.panel h3{margin-top:0}
.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}
.panel-head p,.muted,.inline-note{color:var(--muted);font-size:13px;line-height:1.5}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.field{display:flex;flex-direction:column;gap:7px;min-width:0}
.field.full{grid-column:1/-1}
label{font-size:12px;color:var(--muted);font-weight:bold}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--border);border-radius:9px;background:var(--bg);color:var(--text)}
textarea{min-height:85px;resize:vertical}
input:focus,select:focus,textarea:focus{outline:2px solid var(--accent-soft)}
.form-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:17px}
.notice{padding:12px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;color:var(--muted);font-size:13px;line-height:1.5;margin-bottom:15px}
.status{display:inline-block;background:var(--surface2);padding:6px 9px;border-radius:20px;font-size:11px}
.hidden{display:none!important}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.item-card{padding:15px;border:1px solid var(--border);border-radius:12px;background:var(--bg)}
.item-card h4{margin:0 0 7px}
.item-card p{font-size:13px;color:var(--muted);line-height:1.5}
.item-actions{display:flex;flex-wrap:wrap;gap:6px}
.empty{padding:24px;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:12px;line-height:1.5}
.section-label{margin:22px 0 12px;padding-bottom:8px;border-bottom:1px solid var(--border);font-weight:bold;font-size:13px}
.check-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.check{display:flex;align-items:center;gap:8px;border:1px solid var(--border);padding:10px;border-radius:9px}
.check input{width:auto}
.choice-pills{display:flex;flex-wrap:wrap;gap:7px;margin-top:2px}.choice-pill{display:flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:8px;padding:8px 10px;font-size:12px;cursor:pointer;color:var(--text);background:var(--surface)}.choice-pill:has(input:checked){background:var(--accent-soft);border-color:var(--accent);font-weight:bold}.choice-pill input{width:auto;margin:0;accent-color:var(--accent)}.anamnesis-select-native{display:none!important}
.admin-lock{max-width:470px;margin:auto}
footer{text-align:center;color:var(--muted);padding:20px;font-size:12px}
@media(max-width:700px){
 .hero{grid-template-columns:1fr}
 .grid.three,.check-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:500px){
 .container{padding:15px 10px}
 .panel,.hero-copy,.hero-side{padding:17px}
 .grid,.grid.three,.check-grid,.cards{grid-template-columns:1fr}
 .panel-head{flex-direction:column}
}

    .cycle-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:10px;border:1px solid var(--border,#444);border-radius:10px}
    .cycle-option{display:flex;align-items:center;gap:7px;font-size:14px;cursor:pointer}
    .cycle-option input{width:auto;accent-color:var(--pink,#ff3f9f)}
.cycle-row{display:grid;grid-template-columns:minmax(130px,1fr) minmax(280px,2fr);gap:10px;align-items:end;margin:8px 0;padding:8px;border:1px solid var(--border,#444);border-radius:8px}.cycle-row .field{margin:0}.cycle-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px 10px}.cycle-option{display:flex;align-items:center;gap:5px;font-size:13px;white-space:nowrap}.cycle-option input{width:auto}.hint{font-size:12px;opacity:.8}@media(max-width:650px){.cycle-row{grid-template-columns:1fr}.cycle-options{grid-template-columns:repeat(2,minmax(0,1fr))}}

.sheet-wrap{width:100%;overflow-x:auto;border:1px solid var(--border);border-radius:10px}
.sheet-table{width:100%;border-collapse:collapse;min-width:520px;background:var(--surface)}
.sheet-table th,.sheet-table td{border:1px solid var(--border);padding:7px;text-align:left}
.sheet-table th{background:var(--surface2);font-size:12px;white-space:nowrap}
.sheet-table td input{border:0;border-radius:4px;padding:9px;min-width:80px;background:var(--bg)}
.sheet-table td:last-child{width:52px;text-align:center}
.sheet-table tfoot th{font-size:14px}
.sheet-remove{padding:6px 9px;border:1px solid var(--border);background:var(--surface2);color:var(--text);border-radius:6px}
.calendar-wrap{border:1px solid var(--border);border-radius:14px;padding:14px;margin:16px 0 20px;background:var(--surface)}
.calendar-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.calendar-month{font-size:18px;font-weight:bold;text-transform:capitalize}
.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}
.calendar-weekday{text-align:center;font-size:12px;font-weight:bold;color:var(--muted);padding:7px 0}
.calendar-day{min-height:64px;border:1px solid var(--border);border-radius:9px;background:var(--bg);color:var(--text);padding:7px;text-align:left;display:flex;flex-direction:column;gap:5px}
.calendar-day:disabled{opacity:.35;cursor:default}
.calendar-day.selected{outline:2px solid var(--accent);background:var(--accent-soft)}
.calendar-day.today{border-color:var(--accent)}
.calendar-count{font-size:11px;color:var(--success);font-weight:bold}
.calendar-footer{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-top:12px;font-size:13px;color:var(--muted)}
@media(max-width:500px){.calendar-wrap{padding:8px}.calendar-day{min-height:49px;padding:4px;font-size:12px}.calendar-count{font-size:9px}.calendar-grid{gap:3px}}

</style>
</head>
<body>
<header>
  <div class="topbar">
    <div class="brand">
      <div class="brand-mark">D</div>
      <div><h1>DayAgenda</h1><p>Seu tempo, seu agendamento.</p></div>
    </div>
    <button class="btn" id="themeToggle" type="button">☾ Tema escuro</button>
  </div>
</header>

<main class="container">
  <section class="hero">
    <div class="hero-copy">
      <span class="status">BELEZA COM ORGANIZAÇÃO</span>
      <h2>Seu próximo momento de cuidado começa aqui.</h2>
      <p>Agende seu horário de forma simples. Escolha um procedimento disponível, informe seus dados e pronto. Não precisa criar conta.</p>
      <button class="btn btn-primary" id="bookJump" type="button">Agendar horário →</button>
    </div>
    <div class="hero-side">
      <div class="hero-icon">✿</div>
      <h3>Um espaço para cuidar de você</h3>
      <p>Os procedimentos e horários são administrados pelo salão.</p>
    </div>
  </section>

  <section id="bookingView">
    <div class="panel" id="bookingPanel">
      <div class="panel-head">
        <div><h3>Agendar um horário</h3><p>Preencha seus dados e escolha o procedimento.</p></div>
        <span class="status">Sem cadastro de cliente</span>
      </div>
      <div class="notice" id="bookingNotice">Configure o Supabase no código para ativar os agendamentos.</div>
      <form id="bookingForm">
        <div class="grid">
          <div class="field"><label for="clientName">Nome completo *</label><input id="clientName" required maxlength="90"></div>
          <div class="field"><label for="clientPhone">Telefone / WhatsApp *</label><input id="clientPhone" required maxlength="25"></div>
          <div class="field"><label for="bookingService">Procedimento *</label><select id="bookingService" required><option value="">Carregando...</option></select></div>
          <div class="field"><label for="bookingDate">Data *</label><input id="bookingDate" type="date" required></div>
          <div class="field"><label for="bookingTime">Horário *</label><select id="bookingTime" required><option value="">Escolha a data primeiro</option></select></div>
          <div class="field"><label for="bookingEmail">E-mail (opcional)</label><input id="bookingEmail" type="email"></div>
          <div class="field full"><label for="bookingNotes">Observações (opcional)</label><textarea id="bookingNotes" maxlength="500"></textarea></div>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Solicitar agendamento</button><button class="btn" type="reset">Limpar</button></div>
        <p class="inline-note">O horário só estará confirmado quando o salão confirmar o agendamento.</p>
      </form>
    </div>
  </section>

  <section id="adminView" class="hidden">
    <div class="panel admin-lock" id="loginPanel">
      <div class="panel-head"><div><h3>Acesso do administrador</h3><p>Entre com a conta autorizada do salão.</p></div><span class="status">Privado</span></div>
      <div class="notice">Não há cadastro público de administrador. A conta precisa existir no Supabase.</div>
      <form id="loginForm">
        <div class="grid">
          <div class="field full"><label for="adminEmail">E-mail do ADM</label><input id="adminEmail" type="email" required autocomplete="username"></div>
          <div class="field full"><label for="adminPassword">Senha</label><input id="adminPassword" type="password" required autocomplete="current-password"></div>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Entrar no painel</button></div>
        <p id="loginMessage" class="inline-note"></p>
      </form>
    </div>

    <div id="adminDashboard" class="hidden">
      <div class="panel">
        <div class="panel-head"><div><h3>Painel do salão</h3><p>Gerencie procedimentos, agendamentos e fichas.</p></div><button class="btn" id="logoutBtn" type="button">Sair</button></div>
        <div class="tabs">
          <button class="tab active" data-admin-tab="services" type="button">Procedimentos</button>
          <button class="tab" data-admin-tab="appointments" type="button">Agendamentos</button>
          <button class="tab" data-admin-tab="anamnesis" type="button">Ficha de anamnese</button>
          <button class="tab" data-admin-tab="saved" type="button">Fichas salvas</button>
        </div>

        <div id="savedAdmin" class="hidden">
          <div class="panel-head">
            <div><h3>Fichas salvas</h3><p>Encontre uma cliente e abra a ficha sem rolar até o final do formulário.</p></div>
            <button class="btn" id="refreshSavedAnamneses" type="button">Atualizar lista</button>
          </div>
          <div class="field" style="margin-bottom:14px"><label for="savedAnamnesisSearch">Buscar por nome ou contato</label><input id="savedAnamnesisSearch" type="search" placeholder="Digite o nome ou telefone da cliente"></div>
          <div id="savedAnamnesisList"><div class="empty">Entre como administrador para carregar as fichas.</div></div>
        </div>

        <div id="servicesAdmin">
          <div class="grid">
            <div>
              <h3 id="serviceFormTitle">Criar procedimento</h3>
              <p class="muted">Cadastre manualmente cada procedimento do salão.</p>
              <form id="serviceForm">
                <input type="hidden" id="serviceId">
                <div class="grid">
                  <div class="field full"><label for="serviceName">Nome do procedimento *</label><input id="serviceName" required maxlength="100"></div>
                  <div class="field"><label for="servicePrice">Preço (R$) *</label><input id="servicePrice" type="number" min="0" step="0.01" required></div>
                  <div class="field"><label for="serviceDuration">Duração (minutos) *</label><input id="serviceDuration" type="number" min="5" step="5" required></div>
                  <div class="field full"><label for="serviceDescription">Descrição</label><textarea id="serviceDescription" maxlength="300"></textarea></div>
                  <div class="field full"><label class="check"><input id="serviceActive" type="checkbox" checked> Procedimento ativo</label></div>
                </div>
                <div class="form-actions"><button class="btn btn-primary" type="submit">Salvar procedimento</button><button class="btn" id="cancelServiceEdit" type="button">Limpar</button></div>
                <p id="serviceMessage" class="inline-note"></p>
              </form>
            </div>
            <div><h3>Procedimentos cadastrados</h3><div id="servicesList" class="cards"><div class="empty">Nenhum procedimento carregado.</div></div></div>
          </div>
        </div>

        <div id="appointmentsAdmin" class="hidden">
          <div class="panel-head"><div><h3>Agendamentos</h3><p>Consulte os horários pelo calendário ou pela lista. Toque em um dia para ver os agendamentos daquela data.</p></div><button class="btn" id="refreshAppointments" type="button">Atualizar</button></div>
          <div class="calendar-wrap">
            <div class="calendar-head"><button class="btn btn-small" id="calendarPrev" type="button" aria-label="Mês anterior">‹ Anterior</button><div class="calendar-month" id="calendarMonth">Calendário</div><button class="btn btn-small" id="calendarNext" type="button" aria-label="Próximo mês">Próximo ›</button></div>
            <div class="calendar-grid" id="appointmentsCalendar"></div>
            <div class="calendar-footer"><span id="calendarSummary">Carregando calendário…</span><button class="btn btn-small" id="calendarShowAll" type="button">Ver todos os agendamentos</button></div>
          </div>
          <div id="appointmentsList"><div class="empty">Nenhum agendamento carregado.</div></div>
        </div>

        <div id="anamnesisAdmin" class="hidden">
          <h3>Ficha de anamnese capilar</h3>
          <div class="notice">As informações de saúde são sensíveis. Use somente com autorização da cliente e mantenha o acesso restrito à profissional responsável.</div>
          <form id="anamnesisForm">
            <input type="hidden" id="anamnesisId">
            <div class="section-label">Dados pessoais</div>
            <div class="grid three">
              <div class="field"><label for="aName">Nome completo *</label><input id="aName" required maxlength="120"></div>
              <div class="field"><label for="aContact">Contato / WhatsApp</label><input id="aContact" maxlength="30"></div>
              <div class="field"><label for="aBirth">Nascimento</label><input id="aBirth" type="date"></div>
              <div class="field"><label for="aAttendant">Atendente</label><input id="aAttendant" maxlength="100"></div>
              <div class="field"><label for="aEmail">E-mail</label><input id="aEmail" type="email" maxlength="150"></div>
              <div class="field"><label for="aProfession">Profissão</label><input id="aProfession" maxlength="100"></div>
            </div>
            <div class="grid" style="margin-top:14px">
              <div class="field"><label for="aComplaint">Queixa principal</label><textarea id="aComplaint"></textarea></div>
              <div class="field"><label for="aGoal">Objetivo final</label><textarea id="aGoal"></textarea></div>
            </div>
            <div class="section-label">Dados Clínicos</div>
            <div class="grid three">
              <div class="field"><label for="aPressure">Pressão arterial</label><select id="aPressure"><option value="">Selecione</option><option>Alta</option><option>Baixa</option><option>Não sabe</option><option>Normal</option></select></div>
              <div class="field"><label for="aSurgery">Cirurgias (entre 1 ano e meio)</label><select id="aSurgery"><option value="">Selecione</option><option>Sim</option><option>Não</option></select></div>
              <div class="field"><label for="aPregnancy">Gestante / parto recente / lactante / menopausa</label><select id="aPregnancy"><option value="">Selecione</option><option>Gestante</option><option>Parto recente</option><option>Lactante</option><option>Menopausa</option><option>Não</option></select></div>
              <div class="field"><label for="aStress">Estresse, depressão, ansiedade</label><select id="aStress"><option value="">Selecione</option><option>Nega</option><option>Sim</option></select></div>
              <div class="field"><label for="aMedication">Medicação</label><select id="aMedication"><option value="">Selecione</option><option>Não</option><option>Sim</option></select></div>
              <div class="field"><label for="aDiet">Dieta alimentar</label><input id="aDiet" placeholder="Informar dieta"></div>
            </div>
            <div class="check-grid" style="margin-top:14px">
              <label class="check"><input type="checkbox" id="aThyroid"> Doença da tireoide</label>
              <label class="check"><input type="checkbox" id="aDiabetes"> Diabetes</label>
              <label class="check"><input type="checkbox" id="aGenetic"> Histórico genético</label>
              <label class="check"><input type="checkbox" id="aAllergy"> Alergias</label>
              <label class="check"><input type="checkbox" id="aAnimals"> Contato com animais</label>
              <label class="check"><input type="checkbox" id="aRadiation"> Exposição à radiação</label>
            </div>
            <div class="grid" style="margin-top:14px">
              <div class="field"><label for="aAllergyDetails">Alergias / outros detalhes</label><textarea id="aAllergyDetails"></textarea></div>
              <div class="field"><label for="aClinicalNotes">Outros / produtos cosméticos que usa</label><textarea id="aClinicalNotes"></textarea></div>
            </div>
            <div class="section-label">Observação tátil / visual</div>
            <div class="grid three">
              <div class="field"><label for="aScalp">Couro cabeludo</label><select id="aScalp"><option value="">Não avaliado</option><option>Normal</option><option>Seco</option><option>Oleoso</option><option>Sensível / irritado</option><option>Descamação</option></select></div>
              <div class="field"><label for="aBulb">Força do bulbo / quebra</label><select id="aBulb"><option value="">Não avaliado</option><option>Normal</option><option>Queda por completo</option><option>Quebra na base</option></select></div>
              <div class="field"><label for="aTipology">Tipologia</label><select id="aTipology"><option value="">Selecione</option><option>Lisótrico 1A, 1B, 1C</option><option>Sinótrico 2A, 2B, 2C, 3A, 3B, 3C</option><option>Ulótrico 4A, 4B, 4C</option></select></div>
              <div class="field"><label for="aLength">Comprimento</label><select id="aLength"><option value="">Não avaliado</option><option>Curto</option><option>Médio</option><option>Longo</option><option>Extra longo</option></select></div>
              <div class="field"><label for="aDensity">Densidade</label><select id="aDensity"><option value="">Não avaliado</option><option>Baixa</option><option>Média</option><option>Alta</option></select></div>
              <div class="field"><label for="aThickness">Espessura</label><select id="aThickness"><option value="">Não avaliado</option><option>Fino</option><option>Médio</option><option>Grosso</option></select></div>
              <div class="field"><label for="aEnds">Pontas</label><select id="aEnds"><option value="">Não avaliado</option><option>Íntegras</option><option>Quebradiças</option></select></div>
              <div class="field"><label for="aPorosity">Porosidade</label><select id="aPorosity"><option value="">Não avaliado</option><option>Sem porosidade</option><option>Pouco poroso</option><option>Muito poroso</option></select></div>
              <div class="field"><label for="aElasticity">Elasticidade</label><select id="aElasticity"><option value="">Não avaliado</option><option>Normal</option><option>Baixa</option><option>Alta</option><option>Sem elasticidade</option></select></div>
            </div>
            <div class="section-label">Histórico capilar</div>
            <div class="grid">
              <div class="field"><label for="aChemistry">Químicas / procedimentos anteriores</label><textarea id="aChemistry"></textarea></div>
              <div class="field"><label for="aProducts">Produtos que costuma usar</label><textarea id="aProducts"></textarea></div>
              <div class="field full"><label for="aNotes">Observações gerais / teste de mecha</label><textarea id="aNotes"></textarea></div>
            </div>
            <div class="section-label">Outras informações</div>
            <div class="grid">
              <div class="field"><label for="aWashFrequency">Frequência de lavagem</label><select id="aWashFrequency"><option value="">Não informado</option><option>1x na semana</option><option>2x na semana</option><option>3x na semana</option><option>Outras</option></select></div>
              <div class="field"><label for="aWaterTemperature">Temperatura da água</label><select id="aWaterTemperature"><option value="">Não informado</option><option>Fria</option><option>Ambiente</option><option>Quente/morna</option></select></div>
              <div class="field"><label for="aHairHabit">Hábito com o cabelo</label><select id="aHairHabit"><option value="">Não informado</option><option>Amarrar contorcendo</option><option>Prender com presilhas</option><option>Boné</option><option>Capacete</option><option>Touca</option><option>Outros</option></select></div>
              <div class="field"><label for="aLastChemical">Último processo químico realizado</label><input id="aLastChemical"></div>
            </div>
            <div class="section-label">Alopecia</div>
            <div class="grid">
              <div class="field"><label for="aAlopeciaLocation">Localização</label><input id="aAlopeciaLocation"></div>
