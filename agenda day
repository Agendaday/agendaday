}
window.addEventListener("hashchange",routeFromHash);
$("bookJump").addEventListener("click",()=>{
  showTab("booking");$("bookingPanel").scrollIntoView({behavior:"smooth"});
});
function showAdminTab(tab){
  state.adminTab=tab;
  $("servicesAdmin").classList.toggle("hidden",tab!=="services");
  $("appointmentsAdmin").classList.toggle("hidden",tab!=="appointments");
  $("anamnesisAdmin").classList.toggle("hidden",tab!=="anamnesis");
  $("savedAdmin").classList.toggle("hidden",tab!=="saved");
  document.querySelectorAll("[data-admin-tab]").forEach(b=>b.classList.toggle("active",b.dataset.adminTab===tab));
