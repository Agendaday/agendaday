}
document.querySelectorAll("[data-admin-tab]").forEach(b=>b.addEventListener("click",()=>showAdminTab(b.dataset.adminTab)));
function updateAdminVisibility(){
  $("loginPanel").classList.toggle("hidden",!!state.session);
  $("adminDashboard").classList.toggle("hidden",!state.session);
}
function escapeHTML(v){
  return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function money(v){return Number(v||0).toLocaleString("pt-BR",{style:"currency",currency:"BRL"})}
function setMessage(id,msg,err=false){
  $(id).textContent=msg;$(id).style.color=err?"var(--danger)":"var(--success)";
}
function localDateISO(d=new Date()){
  return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,10);
}
$("bookingDate").min=localDateISO();
$("bookingDate").addEventListener("change",refreshTimeOptions);
$("bookingService").addEventListener("change",refreshTimeOptions);

function refreshTimeOptions(){
  const sel=$("bookingTime"),date=$("bookingDate").value;
  sel.innerHTML='<option value="">Selecione um horário</option>';
  if(!date)return;
  const booked=state.appointments.filter(a=>a.appointment_date===date&&a.status!=="cancelado").map(a=>(a.appointment_time||"").slice(0,5));
  timeSlots.filter(t=>!booked.includes(t)).forEach(t=>{
    const o=document.createElement("option");o.value=t;o.textContent=t;sel.appendChild(o);
  });
  if(sel.options.length===1)sel.innerHTML='<option value="">Sem horários disponíveis</option>';
}
function renderPublicServices(){
  const sel=$("bookingService");
  sel.innerHTML='<option value="">Selecione um procedimento</option>';
  state.services.filter(s=>s.active).forEach(s=>{
    const o=document.createElement("option");o.value=s.id;o.textContent=`${s.name} · ${money(s.price)} · ${s.duration_minutes} min`;sel.appendChild(o);
  });
  if(!state.services.some(s=>s.active))sel.innerHTML='<option value="">Nenhum procedimento disponível</option>';
  refreshTimeOptions();
}
async function loadServices(){
  if(!db)return;
  const {data,error}=await db.from("da_services").select("*").order("name");
  if(error){$("bookingNotice").textContent="Erro ao carregar procedimentos: "+error.message;return}
  state.services=data||[];renderPublicServices();renderServicesAdmin();
}
function renderServicesAdmin(){
  const host=$("servicesList");
  if(!state.services.length){host.innerHTML='<div class="empty">Nenhum procedimento cadastrado. Crie o primeiro ao lado.</div>';return}
  host.innerHTML=state.services.map(s=>`
    <article class="item-card">
      <h4>${escapeHTML(s.name)} <span class="status">${s.active?"Ativo":"Inativo"}</span></h4>
      <p>${money(s.price)} · ${Number(s.duration_minutes)} minutos<br>${escapeHTML(s.description||"")}</p>
      <div class="item-actions">
        <button class="btn btn-small" data-edit-service="${s.id}">Editar</button>
        <button class="btn btn-small" data-toggle-service="${s.id}">${s.active?"Desativar":"Ativar"}</button>
        <button class="btn btn-danger btn-small" data-delete-service="${s.id}">Excluir</button>
      </div>
    </article>`).join("");
  host.querySelectorAll("[data-edit-service]").forEach(b=>b.addEventListener("click",()=>editService(b.dataset.editService)));
  host.querySelectorAll("[data-toggle-service]").forEach(b=>b.addEventListener("click",()=>toggleService(b.dataset.toggleService)));
  host.querySelectorAll("[data-delete-service]").forEach(b=>b.addEventListener("click",()=>deleteService(b.dataset.deleteService)));
}
$("serviceForm").addEventListener("submit",async e=>{
  e.preventDefault();
  if(!db||!state.session)return setMessage("serviceMessage","Entre no painel conectado ao Supabase.",true);
  const id=$("serviceId").value;
  const row={name:$("serviceName").value.trim(),price:Number($("servicePrice").value),duration_minutes:Number($("serviceDuration").value),description:$("serviceDescription").value.trim()||null,active:$("serviceActive").checked};
  if(!row.name||row.price<0||row.duration_minutes<5)return setMessage("serviceMessage","Confira nome, preço e duração.",true);
  const result=id?await db.from("da_services").update(row).eq("id",id):await db.from("da_services").insert(row);
  if(result.error)return setMessage("serviceMessage","Erro ao salvar: "+result.error.message,true);
  resetServiceForm();await loadServices();setMessage("serviceMessage","Procedimento salvo!");
});
function editService(id){
  const s=state.services.find(x=>String(x.id)===String(id));if(!s)return;
  $("serviceId").value=s.id;$("serviceName").value=s.name;$("servicePrice").value=s.price;
  $("serviceDuration").value=s.duration_minutes;$("serviceDescription").value=s.description||"";
  $("serviceActive").checked=!!s.active;$("serviceFormTitle").textContent="Editar procedimento";
}
function resetServiceForm(){
  $("serviceForm").reset();$("serviceId").value="";$("serviceActive").checked=true;$("serviceFormTitle").textContent="Criar procedimento";
}
$("cancelServiceEdit").addEventListener("click",resetServiceForm);
async function toggleService(id){
  const s=state.services.find(x=>String(x.id)===String(id));if(!s)return;
  const {error}=await db.from("da_services").update({active:!s.active}).eq("id",id);
  if(error)return alert("Erro ao atualizar: "+error.message);await loadServices();
}
async function deleteService(id){
  const s=state.services.find(x=>String(x.id)===String(id));if(!s)return;
  if(!confirm(`Excluir "${s.name}"?`))return;
  const {error}=await db.from("da_services").delete().eq("id",id);
  if(error)return alert("Não foi possível excluir: "+error.message);
  await loadServices();
}

/* AGENDAMENTO PÚBLICO */
$("bookingForm").addEventListener("submit",async e=>{
  e.preventDefault();
  if(!db)return alert("Configure primeiro a URL e a chave pública do Supabase.");
